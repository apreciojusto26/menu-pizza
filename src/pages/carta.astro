---
export const prerender = true;

import { CartDrawer } from "../components/CartDrawer";
import DeliveryBanner from "../components/DeliveryBanner.astro";
import { FloatingWhatsAppButton } from "../components/FloatingWhatsAppButton";
import { MenuExplorer } from "../components/MenuExplorer";
import { WhatsAppOrderButton } from "../components/WhatsAppOrderButton";
import { CART_ENABLED, menuSections, restaurant } from "../data/menu";
import BaseLayout from "../layouts/BaseLayout.astro";

const initialContact = {
  number: restaurant.whatsapp.number,
  display: restaurant.whatsapp.display,
  message: restaurant.whatsapp.defaultMessage,
  placeholder: restaurant.whatsapp.placeholder,
};
const menuSheetUrl = import.meta.env.PUBLIC_MENU_SHEET_URL?.trim() || undefined;
const contactSheetUrl =
  import.meta.env.PUBLIC_CONTACT_SHEET_URL?.trim() || undefined;
---

<BaseLayout
  title={`${restaurant.name} · Carta`}
  description={`Carta digital de ${restaurant.name}: precios de pizzas y empanadas.`}
  noindex
>
  <header class="carta-header">
    <div class="page-shell carta-header-inner">
      <a
        class="brand"
        href="/"
        aria-label={`${restaurant.name}, ir al sitio completo`}
      >
        <span class="brand-mark" aria-hidden="true">
          <img src="/logo-italypizza-mark.png" alt="" width="112" height="78" />
        </span>
        <span>
          <img
            class="brand-wordmark"
            src="/logo-italypizza.png"
            alt={restaurant.name}
            width="113"
            height="30"
          />
          <small>Pizzas &amp; empanadas</small>
        </span>
      </a>
    </div>
  </header>

  <main id="contenido">
    <div class="page-shell menu-wrap">
      <MenuExplorer
        client:load
        sections={menuSections}
        sheetUrl={menuSheetUrl}
      />
    </div>

    <DeliveryBanner />

    <div class="page-shell carta-order-wrap">
      <div class="carta-order-cta">
        <WhatsAppOrderButton
          client:load
          initialContact={initialContact}
          sheetUrl={contactSheetUrl}
        />
      </div>
    </div>
  </main>

  <footer class="carta-footer">
    <p>
      <a href="/">Ver el sitio completo</a> · © {new Date().getFullYear()}{" "}
      {restaurant.name}
    </p>
  </footer>

  <FloatingWhatsAppButton
    client:load
    initialContact={initialContact}
    sheetUrl={contactSheetUrl}
  />
  {
    CART_ENABLED && (
      <CartDrawer client:load sections={menuSections} sheetUrl={menuSheetUrl} />
    )
  }
</BaseLayout>
