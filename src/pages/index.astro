---
import QRCode from "qrcode";

import { ContactCard } from "../components/ContactCard";
import { LocationCard } from "../components/LocationCard";
import { MenuExplorer } from "../components/MenuExplorer";
import { OrderIntro } from "../components/OrderIntro";
import { ScheduleCard } from "../components/ScheduleCard";
import { menuContentStatus, menuSections, restaurant } from "../data/menu";
import BaseLayout from "../layouts/BaseLayout.astro";
import { addLogoToQrSvg } from "../lib/qrLogo";
import { createWhatsAppUrl, getSafePublicMenuUrl } from "../lib/siteLinks";

const initialContact = {
  number: restaurant.whatsapp.number,
  display: restaurant.whatsapp.display,
  message: restaurant.whatsapp.defaultMessage,
  placeholder: restaurant.whatsapp.placeholder,
};
const whatsappUrl = createWhatsAppUrl({
  number: initialContact.number,
  display: initialContact.display,
  message: initialContact.message,
  placeholder: initialContact.placeholder,
});
const publicSiteUrl = getSafePublicMenuUrl(restaurant.menuUrl);
const publicMenuUrl = publicSiteUrl
  ? new URL("/carta", publicSiteUrl).toString()
  : null;
const qrSvg = publicMenuUrl
  ? addLogoToQrSvg(
      await QRCode.toString(publicMenuUrl, {
        type: "svg",
        errorCorrectionLevel: "H",
        margin: 2,
        color: { dark: "#2b1810", light: "#fffaf0" },
      }),
    )
  : null;
const whatsappReady = whatsappUrl !== null;
const pendingBusinessData =
  restaurant.location.placeholder ||
  restaurant.schedule.placeholder ||
  !whatsappReady;
const menuSheetUrl = import.meta.env.PUBLIC_MENU_SHEET_URL?.trim() || undefined;
const contactSheetUrl =
  import.meta.env.PUBLIC_CONTACT_SHEET_URL?.trim() || undefined;
---

<BaseLayout
  title={`${restaurant.name} · Pizzas y empanadas`}
  description={`Carta digital de ${restaurant.name}: pizzas y empanadas para descubrir desde el móvil.`}
>
  <header class="site-header">
    <nav class="topbar page-shell" aria-label="Navegación principal">
      <a
        class="brand"
        href="#inicio"
        aria-label={`${restaurant.name}, volver al inicio`}
      >
        <span class="brand-mark" aria-hidden="true">
          <img src="/logo-italypizza-mark.png" alt="" width="112" height="78" />
        </span>
        <span>
          <img
            class="brand-wordmark"
            src="/logo-italypizza.png"
            alt={restaurant.name}
            width="113"
            height="30"
          />
          <small>Pizzas &amp; empanadas</small>
        </span>
      </a>
      <a class="nav-order" href="#pedidos">Cómo pedir</a>
    </nav>

    <div class="hero page-shell" id="inicio">
      <div class="hero-copy">
        <p class="eyebrow eyebrow--light">
          Carta digital{menuContentStatus.placeholder ? " · Maqueta" : ""}
        </p>
        <h1>Sabor que<br /><em>nos reúne.</em></h1>
        <p class="hero-lead">
          Una carta cálida y sencilla para elegir pizzas y empanadas desde el
          móvil, justo después de escanear el QR.
        </p>
        <div class="hero-actions">
          <a class="button button--cream" href="#carta-heading">Ver la carta</a>
          <a class="button button--ghost" href="#informacion">Información</a>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div class="sun-disc"></div>
        <svg class="pizza-illustration" viewBox="0 0 420 420">
          <circle
            cx="210"
            cy="210"
            r="172"
            fill="#f5c661"
            stroke="#f4ead8"
            stroke-width="18"></circle>
          <circle cx="210" cy="210" r="145" fill="#d95f3f"></circle>
          <path
            d="M102 172c35-66 108-93 173-63 40 18 70 55 79 97-75 28-175 20-252-34Z"
            fill="#f7dc8b"></path>
          <g fill="#f7ead0">
            <circle cx="158" cy="251" r="33"></circle><circle
              cx="260"
              cy="175"
              r="31"></circle>
            <circle cx="265" cy="283" r="29"></circle><circle
              cx="142"
              cy="132"
              r="26"></circle>
          </g>
          <g fill="#356b38">
            <path d="M183 205c27-25 45-6 14 20-18 15-32 5-14-20Z"></path>
            <path d="M306 225c26-22 41-3 12 20-17 13-28 1-12-20Z"></path>
            <path d="M190 305c24-19 38 0 10 19-17 11-27-1-10-19Z"></path>
          </g>
          <g fill="#8f1f21">
            <circle cx="115" cy="218" r="18"></circle><circle
              cx="321"
              cy="167"
              r="18"></circle>
            <circle cx="229" cy="239" r="18"></circle><circle
              cx="305"
              cy="316"
              r="18"></circle>
          </g>
          <path
            d="M93 320c81 70 202 65 277-10"
            fill="none"
            stroke="#2b1810"
            stroke-linecap="round"
            stroke-width="9"
            opacity=".22"></path>
        </svg>
        <span class="art-note art-note--top">Masa<br />con tiempo</span>
        <span class="art-note art-note--bottom">Hecho para<br />compartir</span>
      </div>
    </div>

    <div class="hero-ticker" aria-label="Especialidades de la casa">
      <span>Pizza artesanal</span><i aria-hidden="true">◆</i>
      <span>Empanadas doradas</span><i aria-hidden="true">◆</i>
      <span>Pedidos sencillos</span><i aria-hidden="true">◆</i>
      <span>
        {
          menuContentStatus.placeholder
            ? "Sabores por confirmar"
            : "Carta actualizada"
        }
      </span>
    </div>
  </header>

  <main id="contenido">
    <div class="page-shell menu-wrap">
      <MenuExplorer
        client:visible
        sections={menuSections}
        sheetUrl={menuSheetUrl}
      />
    </div>

    <section
      class="order-section"
      id="pedidos"
      aria-labelledby="pedidos-heading"
    >
      <div class="page-shell order-layout">
        <div class="order-intro">
          <p class="eyebrow eyebrow--light">Sin complicaciones</p>
          <h2 id="pedidos-heading">Del antojo<br />a la mesa.</h2>
          <OrderIntro
            client:visible
            initialContact={initialContact}
            sheetUrl={contactSheetUrl}
          />
        </div>

        <ol class="order-steps">
          <li>
            <span>01</span>
            <div>
              <strong>Escanea</strong><p>
                El QR abre esta carta, sin instalar nada.
              </p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong>Elige</strong><p>
                Filtra, busca y revisa tamaños y precios.
              </p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong>Escríbenos</strong><p>
                {
                  whatsappReady
                    ? "WhatsApp abre con un mensaje preparado."
                    : "El canal de pedido se mostrará cuando esté confirmado."
                }
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section
      class="info-section page-shell"
      id="informacion"
      aria-labelledby="info-heading"
    >
      <div class="section-title">
        <div>
          <p class="eyebrow">Antes de venir</p>
          <h2 id="info-heading">Todo lo importante</h2>
        </div>
        <p>
          {
            pendingBusinessData
              ? "La información pendiente se identifica para evitar confundirla con datos reales."
              : "Información comercial confirmada para preparar tu visita."
          }
        </p>
      </div>

      <div class="info-grid">
        <ScheduleCard
          client:visible
          initialSchedule={restaurant.schedule}
          sheetUrl={contactSheetUrl}
        />
        <LocationCard
          client:visible
          initialLocation={restaurant.location}
          sheetUrl={contactSheetUrl}
        />
        <ContactCard
          client:visible
          initialContact={initialContact}
          sheetUrl={contactSheetUrl}
        />
      </div>

      {
        qrSvg && publicMenuUrl && (
          <aside class="qr-share" aria-labelledby="qr-heading">
            <div
              class="qr-code"
              role="img"
              aria-label={`Código QR con la URL pública de la carta de ${restaurant.name}`}
            >
              <Fragment set:html={qrSvg} />
            </div>
            <div>
              <p class="eyebrow">URL pública confirmada</p>
              <h2 id="qr-heading">Comparte esta carta</h2>
              <p>
                Este código apunta directo a <code>/carta</code>, la vista con
                precios y pedido por WhatsApp, generada a partir de
                <code>PUBLIC_MENU_URL</code> después de validarla.
              </p>
              <a href={publicMenuUrl} target="_blank" rel="noopener noreferrer">
                Comprobar la URL
                <span class="external-link-note">Abre una pestaña nueva</span>
              </a>
            </div>
          </aside>
        )
      }
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-shell footer-main">
      <a
        class="brand brand--footer"
        href="#inicio"
        aria-label={`${restaurant.name}, volver al inicio`}
      >
        <span class="brand-mark" aria-hidden="true">
          <img src="/logo-italypizza-mark.png" alt="" width="112" height="78" />
        </span>
        <span
          ><img
            class="brand-wordmark"
            src="/logo-italypizza.png"
            alt={restaurant.name}
            width="113"
            height="30"
          /><small>Pizzas &amp; empanadas</small></span
        >
      </a>
      <nav aria-label="Enlaces del pie">
        <a href="#carta-heading">Carta</a>
        <a href="#pedidos">Pedidos</a>
        <a href="#informacion">Información</a>
      </nav>
    </div>
    <div class="page-shell footer-bottom">
      <small
        >© {new Date().getFullYear()}{" "}
        {restaurant.name}{
          menuContentStatus.placeholder ? " · Contenido provisional" : ""
        }</small
      >
      <small>Hecho para disfrutarse sin prisa.</small>
    </div>
  </footer>
</BaseLayout>
