---
import { restaurant } from "../data/menu";
import { DeliveryBannerWhatsAppLink } from "./DeliveryBannerWhatsAppLink";

const initialContact = {
  number: restaurant.whatsapp.number,
  display: restaurant.whatsapp.display,
  message: restaurant.whatsapp.defaultMessage,
  placeholder: restaurant.whatsapp.placeholder,
};
const contactSheetUrl =
  import.meta.env.PUBLIC_CONTACT_SHEET_URL?.trim() || undefined;
---

<div class="delivery-banner mt-8" role="region" aria-label="Información de delivery">
  <div class="delivery-banner-inner">
    <p>
      <svg
        class="delivery-banner-icon"
        width="38"
        height="26"
        viewBox="0 0 44 30"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="9" cy="22" r="4.2"></circle>
        <circle cx="35" cy="22" r="4.2"></circle>
        <rect x="1.5" y="6" width="11" height="8.5" rx="1.5"></rect>
        <path d="M13.2 22H21L24 17H29"></path>
        <path d="M35 22L31.5 8.5H28"></path>
        <path d="M14.5 18.5H21"></path>
      </svg>
      <span class="delivery-banner-label">Delivery:</span>
      <span>pedido mínimo <strong>25 €</strong></span>
    </p>

    <span class="delivery-banner-sep" aria-hidden="true"></span>

    <p>
      <span>Costo de <strong class="delivery-banner-shipping">envío</strong> según tu zona —
        <DeliveryBannerWhatsAppLink
          client:visible
          initialContact={initialContact}
          sheetUrl={contactSheetUrl}
        />
      </span>
    </p>

    <span class="delivery-banner-sep" aria-hidden="true"></span>

    <p>
      <span>Se puede pagar con tarjeta o en efectivo — <strong>paga con tarjeta en tu domicilio</strong> con datáfono</span>
    </p>
  </div>
</div>
