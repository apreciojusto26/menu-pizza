# No dejes estas URL vacías en producción: sin ellas, la carta muestra los
# datos de ejemplo incluidos en el proyecto en vez de tu menú real.

# URL de tu Google Sheet publicado como CSV (Archivo > Compartir > Publicar en
# la Web > CSV). Columnas: categoria, nombre, descripcion, etiquetas,
# precio1_nombre, precio1_valor, precio2_nombre, precio2_valor, foto_url, visible.
# Así cualquier persona edita precios, fotos o agrega productos desde la hoja
# de cálculo sin tocar código. Vacío = carta de ejemplo incluida en el proyecto.
PUBLIC_MENU_SHEET_URL=

# URL de una segunda pestaña de la misma Google Sheet, publicada como CSV,
# con el número de WhatsApp (columnas: numero, nombre_visible, mensaje).
# Así se puede cambiar el número sin redeploy, igual que el menú.
PUBLIC_CONTACT_SHEET_URL=
