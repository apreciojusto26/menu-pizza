# No confirmes ningún bloque hasta reemplazar todos sus valores vacíos.

# URL HTTPS pública definitiva. El build genera el QR inline desde este valor.
PUBLIC_MENU_URL=
PUBLIC_MENU_URL_CONFIRMED=false

# URL de tu Google Sheet publicado como CSV (Archivo > Compartir > Publicar en
# la Web > CSV). Asi cualquier persona edita precios, fotos o agrega
# productos desde la hoja de calculo sin tocar codigo. Vacio = carta de
# ejemplo incluida en el proyecto.
PUBLIC_MENU_SHEET_URL=

PUBLIC_LOCATION_LABEL=
PUBLIC_LOCATION_DETAIL=
PUBLIC_LOCATION_CONFIRMED=false

PUBLIC_SCHEDULE_LABEL=
PUBLIC_SCHEDULE_DETAIL=
PUBLIC_SCHEDULE_CONFIRMED=false

# Se usan solo si PUBLIC_CONTACT_SHEET_URL está vacío o falla.
# Solo dígitos, con prefijo internacional y sin el signo +.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_WHATSAPP_DISPLAY=
PUBLIC_WHATSAPP_MESSAGE=
PUBLIC_WHATSAPP_CONFIRMED=false

# URL de una segunda pestaña de la misma Google Sheet, publicada como CSV,
# con el número de WhatsApp (columnas: numero, nombre_visible, mensaje).
# Así el dueño puede cambiar el número sin redeploy, igual que el menú.
# Vacío = se usan las variables PUBLIC_WHATSAPP_* de arriba.
PUBLIC_CONTACT_SHEET_URL=
